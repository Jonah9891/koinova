# Environment Variables (Placeholders only - never commit real secrets)

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-browser
SUPABASE_ANON_KEY=your-anon-key

# Resend Email
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=welcome@koinova.org
NOTIFY_EMAIL=notifications@koinova.org

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=0x4AAAAAAyour_secret_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAyour_site_key

# App Environment
APP_ENV=development
BASE_URL=http://localhost:3000

